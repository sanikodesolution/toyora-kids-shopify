  {%- liquid
    assign rating_value = 0
    assign rating_count = 0
    if product.metafields.reviews.rating.value != blank
      assign rating_value = product.metafields.reviews.rating.value.rating | times: 1.0
      assign rating_count = product.metafields.reviews.rating_count | default: 0
    endif
    assign full_stars = rating_value | floor
    if rating_value == 0
      assign full_stars = 5
    endif
  -%}
  <button
    type="button"
    class="toyora-pdp-rating"
    data-toyora-open-reviews
    aria-label="{% if rating_count > 0 %}{{ rating_value | round: 1 }} out of 5, {{ rating_count }} reviews{% else %}Write a review{% endif %}"
  >
    <span class="toyora-pdp-rating__stars" aria-hidden="true">
      {%- for i in (1..5) -%}
        <svg viewBox="0 0 20 20"><path fill="{% if i <= full_stars %}#FFB800{% else %}#E5E7EB{% endif %}" d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.1l-4.94 2.61.94-5.5-4-3.9 5.53-.8L10 1.5z"/></svg>
      {%- endfor -%}
    </span>
    {%- if rating_count > 0 -%}
      <span class="toyora-pdp-rating__text">{{ rating_value | round: 1 }} ({{ rating_count }})</span>
    {%- else -%}
      <span class="toyora-pdp-rating__text">Write a review</span>
    {%- endif -%}
  </button>

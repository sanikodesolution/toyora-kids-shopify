{%- comment -%}
  Horizontal recommendation card for tablet/mobile.
  Accepts: product, remove_params
{%- endcomment -%}
{%- liquid
  assign product_url = product.url
  if remove_params
    assign product_url = product.url | split: '?' | first
  endif

  assign rec_badge = ''
  assign rec_badge_mod = 'pink'
  if product.compare_at_price > product.price
    assign rec_off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
    assign rec_badge = rec_off | append: '% OFF'
  else
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'best seller' or tag_down contains 'bestseller'
        assign rec_badge = 'BEST SELLER'
        assign rec_badge_mod = 'orange'
        break
      endif
      if tag contains 'tag__new'
        assign rec_badge = tag | split: '_' | last
        if rec_badge == blank
          assign rec_badge = 'NEW'
        endif
        break
      endif
    endfor
  endif

  assign rating_value = product.metafields.reviews.rating.value.rating | default: product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: product.metafields.reviews.rating_count | default: 0
-%}
<article class="toyora-recs-item">
  <a href="{{ product_url }}" class="toyora-recs-item__media" aria-label="{{ product.title | escape }}">
    {%- if rec_badge != blank -%}
      <span class="toyora-recs-item__badge toyora-recs-item__badge--{{ rec_badge_mod }}">{{ rec_badge }}</span>
    {%- endif -%}
    {%- if product.featured_image != blank -%}
      <img
        src="{{ product.featured_image | image_url: width: 280 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        width="140"
        height="140"
        loading="lazy"
      >
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'toyora-recs-item__placeholder' }}
    {%- endif -%}
  </a>

  <div class="toyora-recs-item__info">
    <a href="{{ product_url }}" class="toyora-recs-item__title">{{ product.title }}</a>
    {%- if rating_value != blank -%}
      <div class="toyora-recs-item__rating">
        <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
          <path fill="currentColor" d="M12 2.5l2.7 6.2 6.8.6-5.1 4.5 1.5 6.7L12 16.9 6.1 20.5l1.5-6.7L2.5 9.3l6.8-.6L12 2.5z"/>
        </svg>
        <span>{{ rating_value | round: 1 }}</span>
        {%- if rating_count != blank and rating_count != 0 -%}
          <span class="toyora-recs-item__count">({{ rating_count }})</span>
        {%- endif -%}
      </div>
    {%- endif -%}
    <div class="toyora-recs-item__price{% if product.compare_at_price > product.price %} toyora-recs-item__price--sale{% endif %}">
      <span>{{ product.price | money }}</span>
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </div>
  </div>

  <button
    type="button"
    class="toyora-recs-item__wish"
    data-product-id="{{ product.id }}"
    aria-label="Add {{ product.title | escape }} to wishlist"
    aria-pressed="false"
  >
    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  {%- if section.settings.show_cart_button -%}
    <button
      type="button"
      class="toyora-recs-item__cart"
      data-variant-id="{{ product.selected_or_first_available_variant.id }}"
      data-product-id="{{ product.id }}"
      aria-label="Add {{ product.title | escape }} to cart"
      {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
    >
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true">
        <circle cx="9" cy="20" r="1.4" fill="currentColor"/>
        <circle cx="18" cy="20" r="1.4" fill="currentColor"/>
        <path d="M3 4h2l2.2 11.2a1.6 1.6 0 0 0 1.6 1.3h8.7a1.6 1.6 0 0 0 1.6-1.3L21.2 8H6.2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  {%- endif -%}
</article>

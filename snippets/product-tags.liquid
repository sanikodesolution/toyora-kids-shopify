{%- comment -%}
    TODO: add to theme settings [color, tag...]
    Valid tags:
     - tag__hot_[DISPLAY_TEXT]
     - tag__new_[DISPLAY_TEXT]
     - tag__sale_[DISPLAY_TEXT]
    Example: tag__hot_-50% OFF, tag__new_NEW ARRIVAL
{%- endcomment -%}

{% for tag in product.tags %}
    {% if tag contains 'tag__' %}
        {%- liquid
            assign tag_content = tag | split: '__' | last
            assign type = tag_content | split: '_' | first
            assign tag_name = tag_content | split: '_' | last
            assign color_scheme_class = 'm-color-'
            case type
                when 'sale':
                    assign color_scheme_class = color_scheme_class | append: settings.sale_badge_color_scheme
                when 'new':
                    assign color_scheme_class = color_scheme_class | append: settings.new_badge_color_scheme
                when 'hot':
                    assign color_scheme_class = color_scheme_class | append: settings.hot_badge_color_scheme
            endcase
        -%}
        <span class="m-product-tag m-product-tag--{{ type }} m-gradient {{ color_scheme_class }}">
            {%- if type == 'hot' -%}
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8.7 1.2c.2 1.6-.3 2.8-1.2 3.8-.6.7-.8 1.2-.7 1.9.1.6.5 1.1 1.1 1.4-.9-.1-1.7-.6-2.2-1.4-.4.7-.5 1.5-.3 2.3.3 1.2 1.3 2.1 2.6 2.4-1.6.1-3.2-.8-3.9-2.3C2.9 7.5 3.4 5.3 5.2 3.6c.2 1.1.8 1.9 1.7 2.4C6.4 4.4 7.1 2.7 8.7 1.2zm2.4 5.1c.8.7 1.2 1.7 1.1 2.8-.1 1.8-1.5 3.2-3.3 3.6 2.3-.2 4.1-2.1 4.3-4.4.1-1.3-.3-2.5-1.1-3.4-.2.5-.6.9-1 1.4z"/></svg>
            {%- elsif type == 'new' -%}
              <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 4.2h7.2L13.5 8 9.7 11.8H2.5V4.2z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="5.3" cy="8" r="1" fill="currentColor"/></svg>
            {%- endif -%}
            {{ tag_name }}
        </span>
    {% endif %}
{% endfor %}

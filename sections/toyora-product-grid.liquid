{{ 'toyora-theme.css' | asset_url | stylesheet_tag }}

{% assign collection = collections[section.settings.collection] %}
{% assign products_to_show = section.settings.products_to_show %}
{% assign available_count = collection.products.size %}
{% assign actual_count = products_to_show | at_most: available_count %}
{% assign actual_count = actual_count | at_least: 1 %}

{% assign desktop_cols = actual_count | at_most: 6 %}
{% assign tablet_cols = actual_count | at_most: 3 %}
{% assign mobile_setting = section.settings.products_to_show_mobile %}
{% assign mobile_cols = actual_count | at_most: mobile_setting %}
{% assign mobile_cols = mobile_cols | at_least: 1 %}

<section class="toyora-section toyora-prod" id="toyora-prod-{{ section.id }}">
  <div class="toyora-container">
    <div class="toyora-prod__head">
      <h2 class="toyora-heading">{{ section.settings.heading }} ✨</h2>
      {% if section.settings.view_all_link != blank %}
        <a href="{{ section.settings.view_all_link }}" class="toyora-prod__viewall">{{ section.settings.view_all_text }} →</a>
      {% endif %}
    </div>

    <div class="toyora-prod__grid"
         style="--toyora-cols-desktop:{{ desktop_cols }};--toyora-cols-tablet:{{ tablet_cols }};--toyora-cols-mobile:{{ mobile_cols }};">
      {% for product in collection.products limit: products_to_show %}
        <div class="toyora-prod__card">
          <button
            type="button"
            class="toyora-prod__wish"
            data-product-id="{{ product.id }}"
            aria-label="Add {{ product.title | escape }} to wishlist"
            aria-pressed="false"
          >
            <svg class="toyora-wish-icon" viewBox="0 0 24 24" width="16" height="16" xmlns="http://www.w3.org/2000/svg">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <a href="{{ product.url }}" class="toyora-prod__cardlink">
            <div class="toyora-prod__imgwrap">
              {% if product.compare_at_price > product.price %}
                {% assign off = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price %}
                <span class="toyora-badge toyora-badge--red toyora-prod__badge">{{ off }}% OFF</span>
              {% elsif product.created_at > section.settings.new_since %}
                <span class="toyora-badge toyora-badge--blue toyora-prod__badge">NEW</span>
              {% endif %}
              <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" loading="lazy">
            </div>
            <div class="toyora-prod__info">
              <span class="toyora-prod__title">{{ product.title }}</span>
              {% if product.metafields.reviews.rating %}
                <span class="toyora-prod__rating">★★★★★ ({{ product.metafields.reviews.rating_count }})</span>
              {% endif %}
              <span class="toyora-prod__price">
                {{ product.price | money_without_trailing_zeros }}
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
                {% endif %}
              </span>
            </div>
          </a>
          <div class="toyora-prod__body">
            <button
              type="button"
              class="toyora-btn toyora-btn--primary toyora-prod__addbtn"
              data-variant-id="{{ product.selected_or_first_available_variant.id }}"
              data-product-id="{{ product.id }}"
              {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
            >
              <span class="toyora-addbtn-icon">🛒</span>
              <span class="toyora-addbtn-text">
                {% if product.selected_or_first_available_variant.available %}ADD TO CART{% else %}SOLD OUT{% endif %}
              </span>
            </button>
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  .toyora-prod{ padding:40px 0; }
  .toyora-prod__head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; gap:12px; flex-wrap:wrap; }
  .toyora-prod__head h2{ font-size:22px; margin:0; }
  .toyora-prod__viewall{ color:var(--toyora-blue); font-weight:600; font-size:14px; text-decoration:none; white-space:nowrap; }

  /* Grid columns are driven by CSS variables set inline from Liquid,
     so the grid always fills the row based on the actual number of
     products shown instead of leaving empty space. */
  .toyora-prod__grid{
    display:grid;
    grid-template-columns:repeat(var(--toyora-cols-desktop, 6), 1fr);
    gap:16px;
  }

  .toyora-prod__card{
    position:relative;
    container-type:inline-size;
    container-name:toyora-card;
    background:#fff; border-radius:var(--toyora-radius-md); box-shadow:var(--toyora-shadow);
    color:var(--toyora-dark); overflow:hidden; display:flex; flex-direction:column;
    transition:transform .15s ease;
  }
  .toyora-prod__card:hover{ transform:translateY(-4px); }

  .toyora-prod__cardlink{ text-decoration:none; color:inherit; display:flex; flex-direction:column; flex:1; }

  .toyora-prod__imgwrap{ position:relative; aspect-ratio:1/1; background:#faf9fc; width:100%; }
  .toyora-prod__imgwrap img{ width:100%; height:100%; object-fit:cover; display:block; }
  .toyora-prod__badge{ position:absolute; top:10px; left:10px; z-index:2; }

  /* Wishlist button sits outside the <a> now, so clicking it never
     navigates to the product page. Positioned to match the old spot. */
  .toyora-prod__wish{
    position:absolute; top:10px; right:10px; z-index:3;
    background:#fff; width:28px; height:28px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    border:none; padding:0; cursor:pointer; color:var(--toyora-dark);
    box-shadow:0 2px 6px rgba(42,27,77,.12);
    transition:transform .15s ease, color .15s ease;
  }
  .toyora-prod__wish:hover{ transform:scale(1.08); }
  .toyora-prod__wish .toyora-wish-icon{ transition:fill .15s ease; }
  .toyora-prod__wish.is-active{ color:var(--toyora-red); }
  .toyora-prod__wish.is-active .toyora-wish-icon path{ fill:currentColor; }

  .toyora-prod__info{ padding:12px 12px 4px; display:flex; flex-direction:column; gap:4px; flex:1; }
  .toyora-prod__title{ font-size:13px; font-weight:600; line-height:1.3; min-height:34px; }
  .toyora-prod__rating{ font-size:11px; color:var(--toyora-gold); }
  .toyora-prod__price{ font-size:14px; font-weight:700; color:var(--toyora-red); margin:2px 0 6px; }
  .toyora-prod__price s{ color:#aaa; font-weight:400; font-size:12px; margin-left:4px; }

  .toyora-prod__body{ padding:0 12px 12px; }

  /* Add to cart button: font-size scales with the card's actual width
     (container query units), so "ADD TO CART" always fits on one line
     in full, on every device and column count — no cutoff, no ellipsis. */
  .toyora-prod__addbtn{
    font-size:clamp(9.5px, 6.2cqi, 14px);
    padding:10px 4px;
    justify-content:center;
    align-items:center;
    width:100%;
    white-space:nowrap;
    overflow:hidden;
    gap:4px;
    letter-spacing:-0.2px;
    border:2px solid transparent;
  }
  .toyora-prod__addbtn .toyora-addbtn-text{ white-space:nowrap; }
  .toyora-prod__addbtn:disabled{ background:#ccc; box-shadow:none; cursor:not-allowed; transform:none; }
  .toyora-prod__addbtn.is-loading{ opacity:.7; pointer-events:none; }

  /* Fallback for browsers without container query support: still shrink
     the button text at narrow screens so it doesn't wrap or clip. */
  @supports not (container-type: inline-size){
    @media screen and (max-width:480px){
      .toyora-prod__addbtn{ font-size:10px; padding:9px 2px; }
    }
  }

  /* Responsive: tablet */
  @media screen and (max-width:989px){
    .toyora-prod__grid{ grid-template-columns:repeat(var(--toyora-cols-tablet, 3), 1fr); }
  }

  /* Responsive: mobile — column count controlled separately in theme editor */
  @media screen and (max-width:480px){
    .toyora-prod__grid{ grid-template-columns:repeat(var(--toyora-cols-mobile, 2), 1fr); gap:10px; }
    .toyora-prod__title{ font-size:12px; min-height:auto; }
  }
</style>

<script>
  (function(){
    var sectionEl = document.getElementById('toyora-prod-{{ section.id }}');
    if(!sectionEl) return;

    var WISHLIST_KEY = 'toyora_wishlist';

    sectionEl.addEventListener('click', function(e){
      var wishBtn = e.target.closest('.toyora-prod__wish');
      if(wishBtn){
        e.preventDefault();
        e.stopPropagation();
        toggleWishlist(wishBtn);
        return;
      }

      var addBtn = e.target.closest('.toyora-prod__addbtn');
      if(addBtn){
        e.preventDefault();
        e.stopPropagation();
        if(addBtn.disabled) return;
        addToCart(addBtn);
      }
    });

    function getWishlist(){
      try{
        return JSON.parse(localStorage.getItem(WISHLIST_KEY)) || [];
      }catch(e){
        return [];
      }
    }

    function saveWishlist(list){
      try{ localStorage.setItem(WISHLIST_KEY, JSON.stringify(list)); }catch(e){}
    }

    function refreshWishButtons(){
      var list = getWishlist();
      sectionEl.querySelectorAll('.toyora-prod__wish').forEach(function(btn){
        var id = btn.getAttribute('data-product-id');
        var isActive = list.indexOf(id) !== -1;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }

    function toggleWishlist(btn){
      var id = btn.getAttribute('data-product-id');
      if(!id) return;
      var list = getWishlist();
      var idx = list.indexOf(id);
      if(idx === -1){
        list.push(id);
      }else{
        list.splice(idx, 1);
      }
      saveWishlist(list);
      refreshWishButtons();
      document.dispatchEvent(new CustomEvent('toyora:wishlist:updated', { detail: { wishlist: list } }));
    }

    // Mark already-favorited products as active on page load
    refreshWishButtons();

    function addToCart(btn){
      if(btn.classList.contains('is-loading')) return;
      var variantId = btn.getAttribute('data-variant-id');
      if(!variantId){ return; }

      var textEl = btn.querySelector('.toyora-addbtn-text');
      var originalText = textEl ? textEl.textContent : null;

      btn.classList.add('is-loading');
      if(textEl) textEl.textContent = 'Adding...';

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: variantId, quantity: 1 })
      })
        .then(function(res){
          if(!res.ok){ return res.json().then(function(err){ throw err; }); }
          return res.json();
        })
        .then(function(){
          openCartDrawer();
        })
        .catch(function(err){
          console.error('Toyora add to cart error:', err);
          alert((err && err.description) ? err.description : 'Could not add product to cart.');
        })
        .finally(function(){
          btn.classList.remove('is-loading');
          if(textEl && originalText) textEl.textContent = originalText;
        });
    }

    // Best-effort attempt to refresh + open the theme's existing cart drawer.
    // Different themes (including Minimog) listen for different events / use
    // different trigger elements, so this tries several common patterns.
    // If the drawer still doesn't open automatically, tell us your header
    // cart icon's HTML and we'll wire this to the exact selector.
    function openCartDrawer(){
      document.dispatchEvent(new CustomEvent('cart:refresh'));
      document.dispatchEvent(new CustomEvent('cart:open'));
      document.body.dispatchEvent(new CustomEvent('cart:add'));

      var triggerSelectors = [
        '[data-cart-drawer-toggle]',
        '[data-drawer-toggle="cart"]',
        '[data-action="open-drawer-cart"]',
        '#cart-icon-bounce',
        '.header__icon--cart',
        '.site-header__cart-toggle',
        'a[href="/cart"]'
      ];

      for(var i = 0; i < triggerSelectors.length; i++){
        var el = document.querySelector(triggerSelectors[i]);
        if(el){
          el.dispatchEvent(new Event('click', { bubbles: true }));
          break;
        }
      }
    }
  })();
</script>

{% schema %}
{
  "name": "Toyora Product Grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "NEW ARRIVALS" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show (Desktop/Tablet)", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "range", "id": "products_to_show_mobile", "label": "Products to show (Mobile)", "min": 1, "max": 6, "step": 1, "default": 2 },
    { "type": "text", "id": "view_all_text", "label": "View all text", "default": "View All" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    { "type": "text", "id": "new_since", "label": "Treat as NEW if added after (YYYY-MM-DD)", "default": "2026-07-01" }
  ],
  "presets": [ { "name": "Toyora Product Grid" } ]
}
{% endschema %}

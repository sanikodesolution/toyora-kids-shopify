{{ 'toyora-theme.css' | asset_url | stylesheet_tag }}

<section class="toyora-section toyora-promos">
  <div class="toyora-container toyora-promos__grid" style="--cols:{{ section.blocks.size }};">
    {% for block in section.blocks %}
      <a href="{{ block.settings.link }}" class="toyora-promo" style="background:{{ block.settings.bg_color }};">
        <div class="toyora-promo__text">
          <span class="toyora-promo__title">{{ block.settings.title }}</span>
          <span class="toyora-promo__subtitle">{{ block.settings.subtitle }}</span>
          <span class="toyora-btn toyora-promo__btn" style="color:{{ block.settings.bg_color }};">{{ block.settings.btn_text }}</span>
        </div>
        {% if block.settings.image != blank %}
          <img class="toyora-promo__img" src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.title }}" loading="lazy">
        {% endif %}
      </a>
    {% endfor %}
  </div>
</section>

<style>
  .toyora-promos{ padding:24px 0; }
  .toyora-promos__grid{
    display:grid;
    grid-template-columns:repeat(var(--cols,3),1fr);
    gap:20px;
  }
  .toyora-promo{
    position:relative;
    border-radius:var(--toyora-radius-lg);
    min-height:220px;
    padding:28px;
    display:flex;
    align-items:flex-end;
    text-decoration:none;
    overflow:hidden;
  }
  .toyora-promo__text{ display:flex; flex-direction:column; gap:6px; position:relative; z-index:2; }
  .toyora-promo__title{ font-family:var(--toyora-font-display); font-weight:700; font-size:22px; color:#fff; }
  .toyora-promo__subtitle{ font-size:13px; color:rgba(255,255,255,.9); margin-bottom:8px; }
  .toyora-promo__btn{ background:#fff; padding:8px 18px; font-size:13px; align-self:flex-start; }
  .toyora-promo__img{
    position:absolute;
    right:-10px; bottom:-10px;
    width:55%;
    max-width:220px;
    object-fit:contain;
    z-index:1;
    opacity:.95;
  }

  @media screen and (max-width:749px){
    .toyora-promos__grid{ grid-template-columns:1fr; }
  }
</style>

{% schema %}
{
  "name": "Toyora Promo Banners",
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "SPACE TOYS" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Explore The Universe" },
        { "type": "text", "id": "btn_text", "label": "Button text", "default": "SHOP NOW" },
        { "type": "color", "id": "bg_color", "label": "Background color", "default": "#9B6BFF" },
        { "type": "image_picker", "id": "image", "label": "Corner image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Toyora Promo Banners",
      "blocks": [
        { "type": "banner", "settings": { "title": "SPACE TOYS", "subtitle": "Explore The Universe", "btn_text": "SHOP NOW", "bg_color": "#9B6BFF" } },
        { "type": "banner", "settings": { "title": "EDUCATIONAL TOYS", "subtitle": "Learn Through Play", "btn_text": "EXPLORE", "bg_color": "#FF3B6E" } },
        { "type": "banner", "settings": { "title": "OUTDOOR FUN", "subtitle": "Active Play, Happy Day", "btn_text": "SHOP NOW", "bg_color": "#FFC93D" } }
      ]
    }
  ]
}
{% endschema %}

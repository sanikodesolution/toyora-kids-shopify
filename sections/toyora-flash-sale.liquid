{{ 'toyora-theme.css' | asset_url | stylesheet_tag }}

<section class="toyora-section toyora-flash" id="toyora-flash-{{ section.id }}">
  <div class="toyora-container">
    <div class="toyora-flash__inner">

    <div class="toyora-flash__left">
      <span class="toyora-flash__badge">⚡ {{ section.settings.heading }}</span>
      <p class="toyora-flash__sub">{{ section.settings.subheading }}</p>
      <div class="toyora-flash__timer" data-end="{{ section.settings.end_date }}">
        <div class="toyora-flash__unit"><span data-unit="days">00</span><small>Days</small></div>
        <span class="toyora-flash__dot" aria-hidden="true"></span>
        <div class="toyora-flash__unit"><span data-unit="hours">00</span><small>Hrs</small></div>
        <span class="toyora-flash__dot" aria-hidden="true"></span>
        <div class="toyora-flash__unit"><span data-unit="minutes">00</span><small>Mins</small></div>
        <span class="toyora-flash__dot" aria-hidden="true"></span>
        <div class="toyora-flash__unit"><span data-unit="seconds">00</span><small>Secs</small></div>
      </div>
    </div>

    <div class="toyora-flash__products">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}
        {% if product != blank %}
          <a href="{{ product.url }}" class="toyora-flash__card">
            <span class="toyora-flash__imgwrap">
              <img src="{{ product.featured_image | image_url: width: 300 }}" alt="{{ product.title }}" loading="lazy">
            </span>
            <span class="toyora-flash__title">{{ product.title }}</span>
            <span class="toyora-flash__price">
              {{ product.price | money_without_trailing_zeros }}
              {% if product.compare_at_price > product.price %}
                <s>{{ product.compare_at_price | money_without_trailing_zeros }}</s>
              {% endif %}
            </span>
          </a>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.view_all_text != blank %}
      <a href="{{ section.settings.view_all_link | default: '#' }}" class="toyora-btn toyora-flash__viewall">{{ section.settings.view_all_text }}</a>
    {% endif %}
    </div>
  </div>
</section>

<style>
  .toyora-flash{ padding:8px 0; }
  .toyora-flash__inner{
    background:linear-gradient(90deg, var(--toyora-red), #FF6B9D);
    border-radius:var(--toyora-radius-lg);
    padding:24px 28px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:24px;
    flex-wrap:nowrap;
    color:#fff;
    box-sizing:border-box;
    overflow:hidden;
  }
  .toyora-flash__left{
    min-width:200px;
    flex-shrink:0;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;
  }
  .toyora-flash__badge{ font-family:var(--toyora-font-display); font-weight:700; font-size:20px; }
  .toyora-flash__sub{ font-size:13px; opacity:.9; margin:4px 0 12px; }
  .toyora-flash__timer{ display:flex; gap:8px; justify-content:flex-start; }
  .toyora-flash__unit{
    background:#fff;
    color:var(--toyora-dark);
    border-radius:10px;
    padding:8px 10px;
    text-align:center;
    min-width:48px;
  }
  .toyora-flash__unit span{ display:block; font-family:var(--toyora-font-display); font-size:18px; font-weight:700; }
  .toyora-flash__unit small{ font-size:10px; opacity:.85; color:var(--toyora-red); text-transform:uppercase; }

  .toyora-flash__products{
    display:flex;
    align-items:center;
    justify-content:center;
    gap:12px;
    flex:0 1 auto;
    min-width:0;
    max-width:100%;
    overflow-x:auto;
    overflow-y:hidden;
    -webkit-overflow-scrolling:touch;
    scroll-snap-type:x proximity;
    padding:4px 2px 8px;
  }
  .toyora-flash__products::-webkit-scrollbar{ height:6px; }
  .toyora-flash__products::-webkit-scrollbar-thumb{ background:rgba(255,255,255,.5); border-radius:10px; }

  .toyora-flash__card{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    background:#fff;
    border-radius:14px;
    padding:10px;
    width:120px;
    flex:0 0 120px;
    box-sizing:border-box;
    text-align:center;
    text-decoration:none;
    color:var(--toyora-dark);
    scroll-snap-align:start;
  }
  .toyora-flash__imgwrap{
    display:block;
    width:100%;
    aspect-ratio:1/1;
    border-radius:10px;
    overflow:hidden;
    margin-bottom:6px;
    background:#fff;
    position:relative;
  }
  .toyora-flash__card img{
    position:absolute;
    inset:0;
    display:block;
    width:100%;
    height:100%;
    max-width:none;
    max-height:none;
    object-fit:contain;
    object-position:center;
    padding:4px;
    box-sizing:border-box;
  }
  .toyora-flash__title{
    display:block;
    font-size:12px;
    font-weight:600;
    line-height:1.25;
    margin-bottom:4px;
    width:100%;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .toyora-flash__price{ font-size:13px; font-weight:700; color:var(--toyora-red); display:block; width:100%; text-align:center; }
  .toyora-flash__price s{ color:#aaa; font-weight:400; margin-left:4px; }

  .toyora-flash__viewall{
    background:#fff;
    color:var(--toyora-red);
    border:2px solid #fff;
    white-space:nowrap;
    flex-shrink:0;
    padding:5px 10px;
    font-size:13px;
    margin:0;
    border-radius:999px;
  }

  .toyora-flash__dot{ display:none; }

  @media screen and (max-width:1199px){
    .toyora-flash__inner{
      display:grid;
      grid-template-columns:1fr auto;
      grid-template-areas:
        "badge viewall"
        "timer timer"
        "products products";
      align-items:center;
      justify-content:stretch;
      gap:14px 8px;
      padding:18px 16px 16px;
      overflow:hidden;
      background:linear-gradient(180deg, var(--toyora-red) 0%, #FF6B9D 100%);
    }
    .toyora-flash__left{
      display:contents;
      min-width:0;
    }
    .toyora-flash__badge{
      grid-area:badge;
      font-size:18px;
    }
    .toyora-flash__sub{ display:none; }
    .toyora-flash__timer{
      grid-area:timer;
      justify-content:center;
      align-items:flex-start;
      gap:10px;
    }
    .toyora-flash__dot{
      display:block;
      width:5px;
      height:5px;
      border-radius:50%;
      background:#fff;
      margin-top:22px;
      flex-shrink:0;
    }
    .toyora-flash__unit{
      background:transparent;
      padding:0;
      min-width:0;
      display:flex;
      flex-direction:column;
      align-items:center;
      gap:6px;
    }
    .toyora-flash__unit span{
      width:52px;
      height:52px;
      background:#fff;
      border-radius:12px;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:18px;
      color:var(--toyora-dark);
    }
    .toyora-flash__unit small{
      color:#fff;
      opacity:1;
      font-size:10px;
      font-weight:600;
      letter-spacing:.04em;
    }
    .toyora-flash__products{
      grid-area:products;
      width:100%;
      max-width:none;
      justify-content:center;
      gap:10px;
      padding:2px 0 4px;
    }
    .toyora-flash__card{
      width:118px;
      flex:0 0 118px;
      align-items:flex-start;
      text-align:left;
      box-shadow:0 6px 16px rgba(42,27,77,.12);
    }
    .toyora-flash__title,
    .toyora-flash__price{ text-align:left; }
    .toyora-flash__viewall{
      grid-area:viewall;
      background:transparent;
      color:#fff;
      border:none;
      padding:0;
      font-size:13px;
      font-weight:600;
      box-shadow:none;
    }
    .toyora-flash__viewall:hover{ transform:none; }
  }

  @media screen and (max-width:749px){
    .toyora-flash__inner{ padding:16px 14px 14px; gap:12px 6px; }
    .toyora-flash__unit span{ width:48px; height:48px; font-size:16px; }
    .toyora-flash__dot{ margin-top:20px; }
    .toyora-flash__card{ width:104px; flex:0 0 104px; padding:8px; }
  }

  @media screen and (max-width:480px){
    .toyora-flash__badge{ font-size:16px; }
    .toyora-flash__timer{ gap:8px; }
    .toyora-flash__unit span{ width:44px; height:44px; font-size:15px; }
    .toyora-flash__unit small{ font-size:9px; }
    .toyora-flash__dot{ margin-top:18px; width:4px; height:4px; }
    .toyora-flash__card{ width:96px; flex:0 0 96px; padding:7px; border-radius:12px; }
    .toyora-flash__title{ font-size:11px; }
    .toyora-flash__price{ font-size:11px; }
  }
</style>

<script>
(function(){
  var wrap = document.querySelector('#toyora-flash-{{ section.id }} .toyora-flash__timer');
  if(!wrap) return;
  var end = new Date(wrap.dataset.end).getTime();
  function tick(){
    var now = new Date().getTime();
    var diff = Math.max(0, end - now);
    var d = Math.floor(diff / (1000*60*60*24));
    var h = Math.floor((diff % (1000*60*60*24)) / (1000*60*60));
    var m = Math.floor((diff % (1000*60*60)) / (1000*60));
    var s = Math.floor((diff % (1000*60)) / 1000);
    wrap.querySelector('[data-unit="days"]').textContent = String(d).padStart(2,'0');
    wrap.querySelector('[data-unit="hours"]').textContent = String(h).padStart(2,'0');
    wrap.querySelector('[data-unit="minutes"]').textContent = String(m).padStart(2,'0');
    wrap.querySelector('[data-unit="seconds"]').textContent = String(s).padStart(2,'0');
  }
  tick();
  setInterval(tick, 1000);
})();
</script>

{% schema %}
{
  "name": "Toyora Flash Sale",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "FLASH SALE" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Hurry up! Limited time offer" },
    { "type": "text", "id": "end_date", "label": "End date/time (e.g. 2026-08-20T23:59:59)", "default": "2026-08-20T23:59:59" },
    { "type": "text", "id": "view_all_text", "label": "View all button text", "default": "VIEW ALL DEALS" },
    { "type": "url", "id": "view_all_link", "label": "View all link" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [
    { "name": "Toyora Flash Sale", "blocks": [ { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" }, { "type": "product" } ] }
  ]
}
{% endschema %}

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
{{ 'component-product-inventory.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign product_id = product.id
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign remove_params = section.settings.remove_params

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m:block m-product-recommendations m-swiper-overflow m-gradient m-color-' | append: section.settings.color_scheme
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif

  assign image_ratio = section.settings.pcard_image_ratio | default: '1/1'
  if image_ratio == blank or image_ratio == 'original'
    assign image_ratio = '1/1'
  endif

  assign show_cart_button = section.settings.show_cart_button
  unless show_cart_button
    assign classes = classes | append: ' toyora-recs--hide-cart'
  endunless
-%}

{%- capture gridClass -%}
  m:grid-2-cols md:m:grid-{{ section.settings.columns | minus: 1 }}-cols xl:m:grid-{{ section.settings.columns }}-cols
{%- endcapture -%}

{%- style -%}
  #m-section--{{ section.id }} {
    --column-gap: {{ section.settings.column_gap }}px;
    --column-gap-mobile: 16px;
    --row-gap: {{ section.settings.column_gap | plus: 10 }}px;
    --row-gap-mobile: 12px;
    --items: {{ section.settings.columns }};
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --rec-image-ratio: {{ image_ratio }};
  }

  #m-section--{{ section.id }} .m:column,
  #m-section--{{ section.id }} .swiper-slide {
    height: auto;
    display: flex;
  }

  #m-section--{{ section.id }} .m-product-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    background: #fff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    overflow: hidden;
    box-sizing: border-box;
  }

  #m-section--{{ section.id }} .m-product-card__media [style*='--aspect-ratio'] {
    --aspect-ratio: var(--rec-image-ratio) !important;
  }

  #m-section--{{ section.id }} .m-product-card__media [style*='--aspect-ratio'] > *:first-child,
  #m-section--{{ section.id }} .m-product-card__media img,
  #m-section--{{ section.id }} .m-product-card__media .m-placeholder-svg {
    object-fit: contain !important;
    object-position: center;
  }

  #m-section--{{ section.id }} .m-product-card__media img {
    padding: 8px;
    box-sizing: border-box;
  }

  #m-section--{{ section.id }} .m-product-card__content {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    padding:0 20px 20px;
  }

  #m-section--{{ section.id }} .m-product-card__title {
    min-height: 2.6em;
  }

  #m-section--{{ section.id }} .m-product-card__name,
  #m-section--{{ section.id }} .m-product-card__title a {
    transition: color 0.2s ease;
  }

  #m-section--{{ section.id }} .m-product-card:hover .m-product-card__name,
  #m-section--{{ section.id }} .m-product-card:hover .m-product-card__title a,
  #m-section--{{ section.id }} .m-product-card__name:hover,
  #m-section--{{ section.id }} .m-product-card__title a:hover {
    color: #f42361 !important;
  }

  #m-section--{{ section.id }} .m-product-card .m-button,
  #m-section--{{ section.id }} .m-product-card .m-add-to-cart,
  #m-section--{{ section.id }} .m-product-card .m-button--icon {
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  #m-section--{{ section.id }} .m-product-card .m-button:hover,
  #m-section--{{ section.id }} .m-product-card .m-button:focus,
  #m-section--{{ section.id }} .m-product-card .m-add-to-cart:hover,
  #m-section--{{ section.id }} .m-product-card .m-add-to-cart:focus,
  #m-section--{{ section.id }} .m-product-card .m-button--white:hover,
  #m-section--{{ section.id }} .m-product-card .m-button--secondary:hover,
  #m-section--{{ section.id }} .m-product-card .m-button--primary:hover,
  #m-section--{{ section.id }} .m-product-card .m-button--icon:hover,
  #m-section--{{ section.id }} .m-product-card .m-wishlist-button:hover {
    background: #f42361 !important;
    background-color: #f42361 !important;
    border-color: #f42361 !important;
    color: #fff !important;
    box-shadow: 0 0 0 0.2rem rgba(244, 35, 97, 0.25);
  }

  #m-section--{{ section.id }}.toyora-recs--hide-cart .m-product-card__action-wrapper,
  #m-section--{{ section.id }}.toyora-recs--hide-cart .m-product-card__atc-button,
  #m-section--{{ section.id }}.toyora-recs--hide-cart .m-add-to-cart,
  #m-section--{{ section.id }}.toyora-recs--hide-cart .m-product-card__media .m-product-card__action .m-product-form {
    display: none !important;
  }

  #m-section--{{ section.id }} .toyora-recs__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 16px;
    text-align: left !important;
  }

  #m-section--{{ section.id }} .toyora-recs__head .m-section__heading {
    margin: 0;
  }

  #m-section--{{ section.id }} .toyora-recs__viewall {
    flex-shrink: 0;
    color: #6c63ff;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  #m-section--{{ section.id }} .toyora-recs-list {
    display: none;
  }

  @media screen and (max-width: 1023px) {
    #m-section--{{ section.id }} .m-product-recommendations__wrapper,
    #m-section--{{ section.id }} .m-slider-controls {
      display: none !important;
    }

    #m-section--{{ section.id }} .toyora-recs-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    #m-section--{{ section.id }} .toyora-recs-item {
      position: relative;
      display: flex;
      align-items: stretch;
      gap: 14px;
      padding: 12px;
      background: #fff;
      border: 1px solid #e5e7eb;
      border-radius: 14px;
    }

    #m-section--{{ section.id }} .toyora-recs-item__media {
      position: relative;
      flex: 0 0 108px;
      width: 108px;
      height: 108px;
      border-radius: 10px;
      overflow: hidden;
      background: #fff;
    }

    #m-section--{{ section.id }} .toyora-recs-item__media img,
    #m-section--{{ section.id }} .toyora-recs-item__placeholder {
      width: 100%;
      height: 100%;
      object-fit: contain;
      padding: 6px;
      box-sizing: border-box;
      display: block;
    }

    #m-section--{{ section.id }} .toyora-recs-item__badge {
      position: absolute;
      top: 6px;
      left: 6px;
      z-index: 1;
      padding: 3px 8px;
      border-radius: 6px;
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.02em;
      line-height: 1.3;
      color: #fff;
    }

    #m-section--{{ section.id }} .toyora-recs-item__badge--pink {
      background: #f42361;
    }

    #m-section--{{ section.id }} .toyora-recs-item__badge--orange {
      background: #ff8a3d;
    }

    #m-section--{{ section.id }} .toyora-recs-item__info {
      flex: 1 1 auto;
      min-width: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 2px 40px 2px 0;
      gap: 4px;
    }

    #m-section--{{ section.id }} .toyora-recs-item__title {
      display: block;
      color: #1a1a37;
      font-size: 16px;
      font-weight: 800;
      line-height: 1.3;
      text-decoration: none;
    }

    #m-section--{{ section.id }} .toyora-recs-item:hover .toyora-recs-item__title,
    #m-section--{{ section.id }} .toyora-recs-item__title:hover {
      color: #f42361;
    }

    #m-section--{{ section.id }} .toyora-recs-item__rating {
      display: flex;
      align-items: center;
      gap: 4px;
      color: #6b7280;
      font-size: 13px;
      font-weight: 600;
    }

    #m-section--{{ section.id }} .toyora-recs-item__rating svg {
      color: #ffb800;
      flex-shrink: 0;
    }

    #m-section--{{ section.id }} .toyora-recs-item__count {
      font-weight: 500;
      color: #9ca3af;
    }

    #m-section--{{ section.id }} .toyora-recs-item__price {
      display: flex;
      align-items: baseline;
      gap: 8px;
      color: #1a1a37;
      font-size: 16px;
      font-weight: 800;
    }

    #m-section--{{ section.id }} .toyora-recs-item__price--sale {
      color: #f42361;
    }

    #m-section--{{ section.id }} .toyora-recs-item__price s {
      color: #9ca3af;
      font-size: 13px;
      font-weight: 500;
    }

    #m-section--{{ section.id }} .toyora-recs-item__wish {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 32px;
      height: 32px;
      padding: 0;
      border: 0;
      background: transparent;
      color: #9ca3af;
      cursor: pointer;
    }

    #m-section--{{ section.id }} .toyora-recs-item__wish.is-active,
    #m-section--{{ section.id }} .toyora-recs-item__wish:hover {
      color: #f42361;
    }

    #m-section--{{ section.id }} .toyora-recs-item__wish.is-active path {
      fill: currentColor;
    }

    #m-section--{{ section.id }} .toyora-recs-item__cart {
      position: absolute;
      right: 10px;
      bottom: 10px;
      width: 40px;
      height: 40px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: #f42361;
      color: #fff;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 6px 14px rgba(244, 35, 97, 0.28);
    }

    #m-section--{{ section.id }} .toyora-recs-item__cart:hover {
      background: #dc1b54;
    }

    #m-section--{{ section.id }} .toyora-recs-item__cart:disabled {
      background: #d1d5db;
      box-shadow: none;
      cursor: not-allowed;
    }
  }

  @media screen and (max-width: 767px) {
    #m-section--{{ section.id }} .toyora-recs__head .m-section__heading {
      font-size: 20px;
    }

    #m-section--{{ section.id }} .toyora-recs-item {
      padding: 10px;
      gap: 10px;
    }

    #m-section--{{ section.id }} .toyora-recs-item__media {
      flex-basis: 92px;
      width: 92px;
      height: 92px;
    }

    #m-section--{{ section.id }} .toyora-recs-item__title {
      font-size: 15px;
    }

    #m-section--{{ section.id }} .toyora-recs-item__cart {
      width: 36px;
      height: 36px;
    }
  }
{%- endstyle -%}
<section
  id="m-section--{{ section.id }}"
  class="{{ classes }}"
>
  <product-recommendations
    data-items-per-page="{{ section.settings.columns }}"
    data-enable-slider="{{ section.settings.enable_slider }}"
    data-use-scroll-mobile="{{ section.settings.use_scroll_mobile }}"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product_id }}&limit={{ section.settings.limit | default: 4 }}"
  >
    {% if recommendations.performed and recommendations.products_count > 0 %}
      <div class="{{ container }} m-section-my m-section-py">
        {% assign default_heading = 'products.product.product_recommendation_heading' | t %}
        {% assign view_all_url = section.settings.view_all_link | default: routes.all_products_collection_url %}
        {% assign view_all_text = section.settings.view_all_text | default: 'View All' %}
        <div class="m-section__header toyora-recs__head">
          <h2 class="m-section__heading {{ section.settings.heading_size }}{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
            {{ section.settings.heading | default: default_heading }}
          </h2>
          <a href="{{ view_all_url }}" class="toyora-recs__viewall">{{ view_all_text }} →</a>
        </div>
        <div class="toyora-recs-list">
          {% for product in recommendations.products %}
            {% render 'toyora-recs-list-item', product: product, remove_params: remove_params %}
          {% endfor %}
        </div>
        <div class="m-product-recommendations__wrapper m-slider-control-hover-inside m-mixed-layout{% if section.settings.use_scroll_mobile %} m-mixed-layout--mobile-scroll{% endif %}">
          <div class="m-product-list {% if section.settings.enable_slider %} swiper-container{% endif %}">
            <div class="m:grid {{ gridClass | strip_newlines }} m-mixed-layout__inner{% if section.settings.enable_slider %} swiper-wrapper{% endif %}">
              {% for product in recommendations.products %}
                <div class="m:column swiper-slide">
                  {% liquid
                    case settings.pcard_layout
                      when '1'
                        render 'product-card-1', product: product, image_ratio: image_ratio, show_desc: false, show_cart_button: show_cart_button, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '2'
                        render 'product-card-2', product: product, image_ratio: image_ratio, show_desc: false, show_cart_button: show_cart_button, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '3'
                        render 'product-card-3', product: product, image_ratio: image_ratio, show_desc: false, show_cart_button: show_cart_button, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '4'
                        render 'product-card-4', product: product, image_ratio: image_ratio, show_desc: false, show_cart_button: show_cart_button, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                      when '5'
                        render 'product-card-5', product: product, image_ratio: image_ratio, show_desc: false, show_cart_button: show_cart_button, index: forloop.index, animated: animated, animation_effect: animation_effect, remove_params: remove_params
                    endcase
                  %}
                </div>
              {% endfor %}
            </div>
          </div>
          {% if section.settings.enable_slider %}
            {% render 'slider-controls',
              absolute: true,
              show_nav: true,
              container: section.settings.container,
              nav_class: 'm:hidden'
            %}
          {% endif %}
        </div>
      </div>
    {% endif %}
  </product-recommendations>
</section>
<script>
  (function(){
    var sectionEl = document.getElementById('m-section--{{ section.id }}');
    if(!sectionEl) return;
    var WISHLIST_KEY = 'toyora_wishlist';

    function getWishlist(){
      try { return JSON.parse(localStorage.getItem(WISHLIST_KEY)) || []; }
      catch(e){ return []; }
    }
    function saveWishlist(list){
      try { localStorage.setItem(WISHLIST_KEY, JSON.stringify(list)); } catch(e){}
    }
    function refreshWishButtons(){
      var list = getWishlist();
      sectionEl.querySelectorAll('.toyora-recs-item__wish').forEach(function(btn){
        var id = btn.getAttribute('data-product-id');
        var isActive = list.indexOf(id) !== -1;
        btn.classList.toggle('is-active', isActive);
        btn.setAttribute('aria-pressed', isActive ? 'true' : 'false');
      });
    }
    function toggleWishlist(btn){
      var id = btn.getAttribute('data-product-id');
      if(!id) return;
      var list = getWishlist();
      var idx = list.indexOf(id);
      if(idx === -1) list.push(id);
      else list.splice(idx, 1);
      saveWishlist(list);
      refreshWishButtons();
      document.dispatchEvent(new CustomEvent('toyora:wishlist:updated', { detail: { wishlist: list } }));
    }
    function addToCart(btn){
      if(btn.disabled || btn.classList.contains('is-loading')) return;
      var variantId = btn.getAttribute('data-variant-id');
      if(!variantId) return;
      btn.classList.add('is-loading');
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ id: Number(variantId), quantity: 1 })
      })
        .then(function(res){
          if(!res.ok) return res.json().then(function(err){ throw err; });
          return res.json();
        })
        .then(function(){
          document.dispatchEvent(new CustomEvent('cart:refresh'));
          document.dispatchEvent(new CustomEvent('cart:open'));
          if(window.MinimogTheme && window.MinimogTheme.pubSubEvents){
            document.dispatchEvent(new CustomEvent(window.MinimogTheme.pubSubEvents.cartUpdate));
            document.dispatchEvent(new CustomEvent(window.MinimogTheme.pubSubEvents.openCartDrawer));
          }
        })
        .catch(function(err){
          console.error(err);
        })
        .finally(function(){
          btn.classList.remove('is-loading');
        });
    }

    sectionEl.addEventListener('click', function(e){
      var wishBtn = e.target.closest('.toyora-recs-item__wish');
      if(wishBtn){
        e.preventDefault();
        e.stopPropagation();
        toggleWishlist(wishBtn);
        return;
      }
      var cartBtn = e.target.closest('.toyora-recs-item__cart');
      if(cartBtn){
        e.preventDefault();
        e.stopPropagation();
        addToCart(cartBtn);
      }
    });

    var recEl = sectionEl.querySelector('product-recommendations');
    if(recEl && window.MutationObserver){
      new MutationObserver(function(){ refreshWishButtons(); }).observe(recEl, { childList: true, subtree: true });
    }
    refreshWishButtons();
  })();
</script>

{% schema %}
{
  "name": "Product recommendations",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container-fluid",
          "label": "Default"
        },
        {
          "value": "w-full",
          "label": "Full width"
        },
        {
          "value": "container",
          "label": "Use container box"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "remove_params",
      "label": "Remove URL params",
      "default": false,
      "info": "Remove param tracking in product URL"
    },
    {
      "type": "header",
      "content": "Header settings"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You Might Also Like",
      "placeholder": "Product recommendations"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h3",
          "label": "Medium"
        },
        {
          "value": "h2",
          "label": "Large"
        }
      ],
      "default": "h3"
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View All"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link"
    },
    {
      "type": "header",
      "content": "Grid settings"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "default": 8,
      "min": 3,
      "max": 20
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "default": 4,
      "min": 3,
      "max": 8
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "default": 30,
      "min": 0,
      "max": 50,
      "step": 2
    },
    {
      "type": "select",
      "id": "pcard_image_ratio",
      "label": "Image aspect ratio",
      "default": "1/1",
      "info": "Keeps all recommendation images the same height. Products sit inside the box without cropping.",
      "options": [
        {
          "value": "1/1",
          "label": "1:1"
        },
        {
          "value": "3/4",
          "label": "3:4"
        },
        {
          "value": "4/3",
          "label": "4:3"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_cart_button",
      "label": "Show add to cart button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable slider",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile settings"
    },
    {
      "type": "checkbox",
      "id": "use_scroll_mobile",
      "label": "Use horizontal scrollbar",
      "default": false,
      "info": "Leave off so tablet and mobile show a vertical list."
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom Attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product recommendations"
    }
  ]
}
{% endschema %}

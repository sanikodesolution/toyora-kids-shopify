{{ 'toyora-theme.css' | asset_url | stylesheet_tag }}

<section class="toyora-section toyora-agesk">
  <div class="toyora-container toyora-agesk__grid">

    <div class="toyora-agesk__col">
      <div class="toyora-agesk__head">
        <h3 class="toyora-heading">{{ section.settings.age_heading }}</h3>
        {% if section.settings.age_view_all_link != blank %}
          <a href="{{ section.settings.age_view_all_link }}">View All →</a>
        {% endif %}
      </div>
      <div class="toyora-agesk__row">
        {% for block in section.blocks %}
          {% if block.type == 'age' %}
            <a href="{{ block.settings.link }}" class="toyora-agesk__item">
              <span class="toyora-agesk__circle">
                {% if block.settings.image != blank %}
                  <img src="{{ block.settings.image | image_url: width: 140 }}" alt="{{ block.settings.label }}" loading="lazy">
                {% else %}
                  {{ block.settings.emoji }}
                {% endif %}
              </span>
              <span>{{ block.settings.label }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="toyora-agesk__col">
      <div class="toyora-agesk__head">
        <h3 class="toyora-heading">{{ section.settings.skill_heading }}</h3>
        {% if section.settings.skill_view_all_link != blank %}
          <a href="{{ section.settings.skill_view_all_link }}">View All →</a>
        {% endif %}
      </div>
      <div class="toyora-agesk__row">
        {% for block in section.blocks %}
          {% if block.type == 'skill' %}
            <a href="{{ block.settings.link }}" class="toyora-agesk__item">
              <span class="toyora-agesk__square" style="background:{{ block.settings.bg_color }};">
                {{ block.settings.emoji }}
              </span>
              <span>{{ block.settings.label }}</span>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</section>

<style>
  .toyora-agesk{ padding:32px 0; }
  .toyora-agesk__grid{ display:grid; grid-template-columns:1fr 1fr; gap:24px; }
  .toyora-agesk__col{ background:#fff; border-radius:var(--toyora-radius-lg); box-shadow:var(--toyora-shadow); padding:22px; }
  .toyora-agesk__head{ display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; }
  .toyora-agesk__head h3{ font-size:17px; margin:0; }
  .toyora-agesk__head a{ font-size:13px; color:var(--toyora-blue); text-decoration:none; font-weight:600; }
  .toyora-agesk__row{ display:flex; gap:14px; flex-wrap:wrap; }
  .toyora-agesk__item{ display:flex; flex-direction:column; align-items:center; gap:6px; text-decoration:none; color:var(--toyora-dark); font-size:12px; font-weight:600; flex:1; min-width:60px; }
  .toyora-agesk__circle{ width:64px; height:64px; border-radius:50%; overflow:hidden; background:#f2f0fa; display:flex; align-items:center; justify-content:center; font-size:26px; }
  .toyora-agesk__circle img{ width:100%; height:100%; object-fit:cover; }
  .toyora-agesk__square{ width:56px; height:56px; border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:24px; }

  @media screen and (max-width:749px){
    .toyora-agesk__grid{ grid-template-columns:1fr; }
  }
</style>

{% schema %}
{
  "name": "Toyora Age & Skill",
  "settings": [
    { "type": "text", "id": "age_heading", "label": "Age heading", "default": "SHOP BY AGE" },
    { "type": "url", "id": "age_view_all_link", "label": "Age view all link" },
    { "type": "text", "id": "skill_heading", "label": "Skill heading", "default": "SHOP BY LEARNING SKILL" },
    { "type": "url", "id": "skill_view_all_link", "label": "Skill view all link" }
  ],
  "blocks": [
    {
      "type": "age",
      "name": "Age group",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "0-2 Years" },
        { "type": "text", "id": "emoji", "label": "Emoji fallback", "default": "👶" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "skill",
      "name": "Learning skill",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "STEM" },
        { "type": "text", "id": "emoji", "label": "Emoji", "default": "🧪" },
        { "type": "color", "id": "bg_color", "label": "Background", "default": "#E3F0FF" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Toyora Age & Skill",
      "blocks": [
        { "type": "age", "settings": { "label": "0-2 Years", "emoji": "👶" } },
        { "type": "age", "settings": { "label": "3-5 Years", "emoji": "🧸" } },
        { "type": "age", "settings": { "label": "6-8 Years", "emoji": "🚗" } },
        { "type": "age", "settings": { "label": "9-12 Years", "emoji": "🎮" } },
        { "type": "age", "settings": { "label": "12+ Years", "emoji": "🚴" } },
        { "type": "skill", "settings": { "label": "STEM", "emoji": "🧪", "bg_color": "#E3F0FF" } },
        { "type": "skill", "settings": { "label": "Creativity", "emoji": "🎨", "bg_color": "#FFE9D6" } },
        { "type": "skill", "settings": { "label": "Logic", "emoji": "🧩", "bg_color": "#E9E3FF" } },
        { "type": "skill", "settings": { "label": "Motor Skills", "emoji": "🏃", "bg_color": "#E3FFE9" } },
        { "type": "skill", "settings": { "label": "Montessori", "emoji": "🔺", "bg_color": "#FFF3D6" } }
      ]
    }
  ]
}
{% endschema %}

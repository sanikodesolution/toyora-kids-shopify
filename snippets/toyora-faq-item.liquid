{%- if title != blank -%}
  <div class="toyora-faq__item">
    <button type="button" class="toyora-faq__q" data-toyora-faq>
      <span>{{ title }}</span>
      <svg class="toyora-faq__icon" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
    <div class="toyora-faq__a rte">{{ content }}</div>
  </div>
{%- endif -%}

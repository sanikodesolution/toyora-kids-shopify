{{ 'toyora-theme.css' | asset_url | stylesheet_tag }}

<section class="toyora-section toyora-news">
  <div class="toyora-container toyora-news__inner">
    <div class="toyora-news__text">
      <strong>{{ section.settings.heading }}</strong>
      <span>{{ section.settings.subheading }}</span>
    </div>
    {% form 'customer', class: 'toyora-news__form' %}
      {% if form.posted_successfully? %}
        <p class="toyora-news__success">🎉 Subscribed! Thanks for joining Toyora family.</p>
      {% endif %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <input type="email" name="contact[email]" placeholder="{{ section.settings.placeholder }}" required>
      <button type="submit" class="toyora-btn toyora-btn--primary">{{ section.settings.button_text }}</button>
    {% endform %}
  </div>
</section>

<style>
  .toyora-news{ padding:32px 0; }
  .toyora-news__inner{
    background:{{ section.settings.bg_color }};
    border-radius:var(--toyora-radius-lg);
    padding:28px 32px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:20px;
    flex-wrap:wrap;
  }
  .toyora-news__text{ display:flex; flex-direction:column; }
  .toyora-news__text strong{ font-family:var(--toyora-font-display); font-size:19px; color:var(--toyora-dark); }
  .toyora-news__text span{ font-size:13px; color:#7a7288; }
  .toyora-news__form{ display:flex; gap:10px; flex-wrap:wrap; }
  .toyora-news__form input[type="email"]{
    border-radius:999px; border:2px solid #fff; padding:12px 20px; min-width:240px; font-size:14px;
  }
  .toyora-news__success{ font-weight:600; color:var(--toyora-green); }

  @media screen and (max-width:749px){
    .toyora-news__inner{ flex-direction:column; text-align:center; }
    .toyora-news__form{ width:100%; justify-content:center; }
  }
</style>

{% schema %}
{
  "name": "Toyora Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "GET EXCLUSIVE OFFERS & UPDATES" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Subscribe to get special offers, free giveaways and new toy alerts!" },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "SUBSCRIBE" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#FFE3EC" }
  ],
  "presets": [ { "name": "Toyora Newsletter" } ]
}
{% endschema %}

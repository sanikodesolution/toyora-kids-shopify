{% liquid
  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign classes = 'm-section m-product-details-tabs m:block m-gradient m-color-' | append: section.settings.color_scheme
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
%}
{{ 'tabs.css' | asset_url | stylesheet_tag }}
{{ 'toyora-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-details-tabs.js' | asset_url }}" defer="defer"></script>
{%- style -%}
  #m-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}
<m-product-details-tabs
  id="m-section-{{ section.id }}"
  class="{{ classes }} toyora-pdtabs-section"
  data-section-type="product-details-tabs"
  data-section-id="{{ section.id }}"
>
  {%- assign review_count = product.metafields.reviews.rating_count | default: 0 -%}
  <div class="{{ container }} m-section-py">
    <div class="m-tabs toyora-pdtabs {% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">
      <div class="m-tabs__header toyora-pdtabs__header m:display-flex">
        <div class="m-tabs__header-inner toyora-pdtabs__nav">
          {% for block in section.blocks %}
            {%- liquid
              assign tab_label = block.settings.header
              if block.type == 'reviews' and review_count > 0
                assign tab_label = tab_label | append: ' (' | append: review_count | append: ')'
              endif
              assign tab_icon = block.type
              assign heading_down = block.settings.header | downcase
              if heading_down contains 'faq'
                assign tab_icon = 'faq'
              elsif heading_down contains 'ship'
                assign tab_icon = 'shipping'
              elsif heading_down contains 'review'
                assign tab_icon = 'reviews'
              elsif heading_down contains 'desc'
                assign tab_icon = 'description'
              endif
            -%}
            <div
              class="m-tab-header toyora-pdtabs__tab"
              data-block-type="{{ block.type }}"
              data-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <span class="toyora-pdtabs__icon">
                {%- case tab_icon -%}
                  {%- when 'reviews' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M12 3.5 14.6 9l6 .9-4.3 4.2 1 5.9L12 17.3 6.7 20l1-5.9L3.4 9.9l6-.9L12 3.5z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                  {%- when 'shipping' -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M3 7h11v9H3V7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 10h4l3 3v3h-7v-6z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><circle cx="7" cy="18.2" r="1.4" fill="currentColor"/><circle cx="17.5" cy="18.2" r="1.4" fill="currentColor"/></svg>
                  {%- when 'faq' -%}
                    <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="8.2" stroke="currentColor" stroke-width="1.7"/><path d="M9.6 9.4a2.4 2.4 0 1 1 3.3 2.2c-.7.4-1.1.8-1.1 1.6v.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><circle cx="12" cy="16.4" r="1" fill="currentColor"/></svg>
                  {%- else -%}
                    <svg viewBox="0 0 24 24" fill="none"><path d="M7 4h8l4 4v12a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M15 4v5h5" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                {%- endcase -%}
              </span>
              <span class="toyora-pdtabs__label">{{ tab_label }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
      <div class="m-tabs__content m-product-collapsible toyora-pdtabs__content">
        {% for block in section.blocks %}
          <div
            class="m-tab-content--{{ block.type }} m-tab-content"
            data-block-type="{{ block.type }}"
          >
            <div class="m-tab-content__inner">
              {% case block.type %}
                {% when 'description' %}
                  <div class="toyora-pdtabs__desc" data-toyora-desc>
                    <div class="rte toyora-pdtabs__desc-inner">
                      {%- assign description = product.description -%}
                      {{ description }}
                    </div>
                  </div>
                  <button type="button" class="toyora-pdtabs__more" data-toyora-readmore>
                    <span>Read More</span>
                    <svg viewBox="0 0 16 16" fill="none"><path d="M4 6.5 8 10.5 12 6.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </button>
                {% when 'reviews' %}
                  <div class="{{ block.settings.container | default: 'container' }}">
                    {% render 'product-reviews-app__snippet', custom_liquid: block.settings.custom_liquid %}
                  </div>
                {% when 'tab' %}
                  <div class="rte">
                    {{ block.settings.content }}
                    {{ block.settings.content_page.content }}
                  </div>
                {% when 'faq' %}
                  <div class="rte">
                    {{ block.settings.content }}
                  </div>
                {% when 'liquid' %}
                  {{ block.settings.custom_liquid }}
                {% else %}

              {% endcase %}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>
</m-product-details-tabs>
{% schema %}
{
  "name": "Product information tabs",
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container type",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Fixed width"
        },
        {
          "value": "container-fluid",
          "label": "Stretched width"
        },
        {
          "value": "container-narrow",
          "label": "Narrow width"
        }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme"
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Default open first tab on mobile",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 0,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Custom Attributes"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom classes"
    },
    {
      "type": "header",
      "content": "Animations"
    },
    {
      "type": "select",
      "id": "animations",
      "label": "Visible in the view animation",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Inherit global setting"
        },
        {
          "value": "fade-in",
          "label": "Fade in"
        },
        {
          "value": "fade-in-up",
          "label": "Fade in up"
        },
        {
          "value": "fade-in-left",
          "label": "Fade in left"
        },
        {
          "value": "fade-in-right",
          "label": "Fade in right"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "blocks": [
    {
      "type": "description",
      "name": "Product description",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "This tab will show the product's description"
        },
        {
          "type": "text",
          "id": "header",
          "label": "Tab header",
          "default": "Description"
        }
      ]
    },
    {
      "type": "reviews",
      "name": "Product reviews",
      "limit": 1,
      "settings": [
        {
          "type": "header",
          "content": "Requirements",
          "info": "This section requires a product reviews app to work. Such as Shopify product reviews, Growave, Judge.me, Loox"
        },
        {
          "type": "text",
          "id": "header",
          "label": "Tab header",
          "default": "Reviews"
        },
        {
          "type": "select",
          "id": "container",
          "label": "Container type",
          "default": "container",
          "options": [
            {
              "value": "container",
              "label": "Fixed width"
            },
            {
              "value": "container-fluid",
              "label": "Stretched width"
            },
            {
              "value": "container-narrow",
              "label": "Narrow width"
            }
          ]
        },
        {
          "type": "header",
          "content": "Other review app"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid",
          "info": "Paste the liquid code of the app review here"
        }
      ]
    },
    {
      "type": "tab",
      "name": "Custom content",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading",
          "default": "Shipping",
          "placeholder": "Shipping"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content",
          "default": "<p>Shipping cost is based on weight. Just add products to your cart and use the Shipping Calculator to see the shipping price.</p><p>We want you to be 100% satisfied with your purchase. Items can be returned or exchanged within 30 days of delivery.</p>"
        },
        {
          "type": "page",
          "id": "content_page",
          "label": "Tab content from page"
        }
      ]
    },
    {
      "type": "faq",
      "name": "FAQ",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading",
          "default": "FAQ"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "FAQ content",
          "default": "<p>Have a question? Contact us and we will be happy to help.</p>"
        }
      ]
    },
    {
      "type": "liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "text",
          "id": "header",
          "label": "Tab heading",
          "default": "Tab heading"
        },
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom liquid"
        }
      ]
    }
  ]
}
{% endschema %}
